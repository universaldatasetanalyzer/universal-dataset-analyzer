NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@db.your-provider:5432/uda_db
DB_HOST=db.your-provider
DB_PORT=5432
DB_NAME=uda_db
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Auth / app
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
APP_URL=https://your-app-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# Admin access
ADMIN_PAGE_USER=your_admin_username
ADMIN_PAGE_PASS=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# File upload and storage
UPLOAD_DIR=./uploads
# Use local for development. Use s3 for Cloudflare R2 in production.
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=s3; leave empty for local development.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAX_FILE_SIZE=52428800
MAX_DATASET_ROWS=1000000
MAX_DATASET_COLUMNS=200
MAX_STORAGE_BYTES=5368709120
MAX_CONCURRENT_ANALYSES=2
PYTHON_SERVICE_URL=http://python-service:8000
PYTHON_SERVICE_TOKEN=REPLACE_WITH_INTERNAL_SERVICE_TOKEN

# AI / email / OAuth
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GEMINI_MODEL=gemini-3.6-flash
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
EMAIL_FROM=onboarding@resend.dev
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback

# Paddle
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_replace_with_sandbox_api_key
PADDLE_WEBHOOK_URL=https://your-public-host.example/api/billing/webhook
PADDLE_NOTIFICATION_SIGNING_SECRET=pdl_ntfset_replace_with_notification_signing_secret
PADDLE_PRICE_MONTHLY=pri_replace_with_monthly_price_id
PADDLE_PRICE_YEARLY=pri_replace_with_yearly_price_id

# Optional error monitoring. Configure in production only.
SENTRY_DSN=
